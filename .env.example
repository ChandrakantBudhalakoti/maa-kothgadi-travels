# Reviews database: Upstash Redis (free, add it from the Vercel Marketplace; Vercel fills these in).
# SERVER-ONLY: never prefix with NEXT_PUBLIC_.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Password for the owner moderation page at /admin
ADMIN_TOKEN=
